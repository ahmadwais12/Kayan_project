# ─────────────────────────────────────────────────────────────
# Kayan Land Architecture & Construction — environment template
# Copy to `.env` and fill in real values. Never commit `.env`.
# ─────────────────────────────────────────────────────────────

# MySQL 8 connection used by Prisma at runtime and for migrations.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://kayan_user:change-me@localhost:3306/kayan_land"

# Separate empty database used by `prisma migrate dev` for shadow checks.
# Not needed at runtime; required for local development migrations.
SHADOW_DATABASE_URL="mysql://kayan_user:change-me@localhost:3306/kayan_land_shadow"

# Public origin of the site. Used for canonical URLs, sitemap, robots,
# password-reset links, and JSON-LD. No trailing slash.
APP_URL="http://localhost:3333"

# ── Transactional email (optional) ───────────────────────────
# Leave RESEND_API_KEY empty to disable outgoing mail; inquiry
# notifications are then skipped and reset links must be copied manually.
RESEND_API_KEY=""
EMAIL_FROM="Kayan Land <no-reply@example.com>"
INQUIRY_NOTIFICATION_EMAIL="studio@example.com"

# ── Media storage ────────────────────────────────────────────
# Directory for public uploads, relative to the project root.
# Must be writable by the Node process and survive deployments.
STORAGE_DIR="storage/uploads"

# ── Seeding (`npm run db:seed`) ──────────────────────────────
# Used only when no super admin exists yet. The seed refuses to
# overwrite an existing account with the same email. Staff accounts
# (Admin, Content Manager, Editor) use SEED_STAFF_PASSWORD, then
# SEED_ADMIN_PASSWORD, then the development default.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-a-long-unique-password"
SEED_STAFF_PASSWORD=""
ADMIN_NAME="Studio Administrator"

# ── Creating an extra admin (`npm run admin:create`) ─────────
# Password is generated when ADMIN_PASSWORD is omitted and printed
# once to `.admin-credentials.txt` in the project root.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
